# Vidora environment variables
# Copy this file to .env and fill in values.

# Pexels API key (optional, for stock video search)
# Get one free at https://www.pexels.com/api/
VITE_PEXELS_API_KEY=

# Ollama API URL (optional, defaults to http://127.0.0.1:11434)
# OLLAMA_API_URL=http://127.0.0.1:11434

# Fish Audio S2 Pro (локальный TTS через audio.cpp, GGUF в backend/ai-models)
# VIDORA_S2_BIN=C:\путь\к\audiocpp_server.exe   # если бинарь не в backend/ai-models/audiocpp
# VIDORA_S2_BACKEND=cuda                          # cuda | cpu (по умолчанию cuda, если есть NVIDIA)
