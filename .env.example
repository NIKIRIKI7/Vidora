# Vidora environment variables
# Copy this file to .env and fill in values.

# Pexels API key (optional, for stock video search)
# Get one free at https://www.pexels.com/api/
VITE_PEXELS_API_KEY=

# Ollama API URL (optional, defaults to http://127.0.0.1:11434)
# OLLAMA_API_URL=http://127.0.0.1:11434
