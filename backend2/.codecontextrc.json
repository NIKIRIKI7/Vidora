{
    "extensions": ".cs .csproj .sln .ts .tsx .js .jsx .vue .css .scss .html .json .py .toml .ini .env.example .yaml .yml .sh .ps1 .md .config .dockerfile",
    "ignored_paths": ".git, .idea, .vs, .vscode, node_modules, .pnpm-store, dist, build, release, coverage, bin, obj, data_storage, tools, __pycache__, .pytest_cache, .mypy_cache, .ruff_cache, .turbo, .vite, .cache, venv, .venv, .venv-voice, .venv-vosyvoice, .venv-qwen, .venv-moss, venv-cosyvoice, ai-models, test-results, playwright-report, .playwright-mcp",
    "minify": true,
    "remove_comments": true,
    "remove_secrets": true,
    "include_tree": true,
    "include_dependencies": false,
    "include_mermaid": false,
    "skeleton_mode": false,
    "use_git": false,
    "git_base": "",
    "use_gitignore": true,
    "system_prompt": "You are an expert software engineer. Analyze the following codebase structure and file contents.",
    "output_format": "markdown",
    "template_path": "",
    "enable_logging": true,
    "external_editor": "",
    "receive_prereleases": false,
    "llm_check_enabled": false,
    "llm_base_url": "https://api.openai.com/v1",
    "llm_model": "gpt-4o-mini",
    "visible_tabs": [
        "sources",
        "filters",
        "prompts",
        "llm_os",
        "appearance",
        "plugins",
        "hello_world"
    ],
    "visible_actions": [
        "preview",
        "clipboard",
        "chat",
        "editor",
        "file",
        "hello_world_say_hi"
    ],
    "visible_checkboxes": [
        "dedup",
        "aggressive",
        "checkpoints",
        "watch"
    ],
    "language": "",
    "deduplicate": false,
    "save_checkpoints": false,
    "auto_watch": false,
    "prioritize_entry_files": true,
    "preserve_docstrings": false,
    "preserve_imports": false,
    "aggressive_minify": false,
    "approved_plugins": [
        "hello_world"
    ]
}