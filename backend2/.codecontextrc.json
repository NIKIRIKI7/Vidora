{
    "extensions": ".py .toml .ini .env.example .cs .csproj .sln .json .config .env.example .dockerfile .yaml .ps1 .dockerfile .yaml .sh .md",
    "ignored_paths": "__pycache__, venv, .venv, .git, .idea, .pytest_cache, venv-cosyvoice, .venv-vosyvoice, ai-models",
    "minify": true,
    "remove_comments": true,
